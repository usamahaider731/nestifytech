{
    "db": {
        "model": "App\\Models\\Taxonomy",
        "type": "collection",
        "auto_slug": "slug",
        "validation": {
            "title": "required|string|max:255",
            "description": "nullable|string",
            "status": "required|string"
        },
        "schema": [
            {
                "name": "title",
                "type": "string"
            },
            {
                "name": "slug",
                "type": "string"
            },
            {
                "name": "description",
                "type": "longText",
                "nullable": true
            },
            {
                "name": "status",
                "type": "string",
                "default": "publish"
            },
            {
                "name": "type",
                "type": "string",
                "index": true
            },
            {
                "name": "created_at",
                "type": "timestamp",
                "nullable": true
            },
            {
                "name": "updated_at",
                "type": "timestamp",
                "nullable": true
            }
        ],
        "main_fields": [
            "title",
            "description",
            "status",
            "slug"
        ],
        "fixed_fields": {
            "type": "collection"
        },
        "relations": {
            "image": "single_image"
        },
        "meta_fields": "auto",
        "table": "taxonomies"
    },
    "table": {
        "card": {
            "image": "image",
            "title": "title",
            "content": "description",
            "top_right": "status",
            "actions": "action"
        },
        "keywords": true,
        "paginationPerPage": 10,
        "paginationList": [
            10,
            20,
            50,
            100
        ],
        "table": "taxonomies",
        "type": "collection",
        "bulk": {
            "table": "taxonomies",
            "type": "collection",
            "route": "bulk.action",
            "column": "status",
            "is_meta": false,
            "options": [
                {
                    "label": "Delete",
                    "value": "delete"
                },
                {
                    "label": "Publish",
                    "value": "publish"
                },
                {
                    "label": "Draft",
                    "value": "Draft"
                }
            ]
        },
        "columns": [
            {
                "id": "id",
                "label": "ID",
                "column": "id",
                "width": "5%",
                "sort": true
            },
            {
                "id": "image",
                "label": "IMAGE",
                "width": "8%",
                "column": "image",
                "type": "image",
                "key": "filename"
            },
            {
                "id": "title",
                "label": "COLLECTION",
                "column": "title",
                "sort": true,
                "width": "25%"
            },
            {
                "id": "description",
                "label": "DESCRIPTION",
                "column": "description",
                "width": "35%",
                "type": "description"
            },
            {
                "id": "status",
                "label": "STATUS",
                "column": "status",
                "width": "12%",
                "type": "status_dot"
            },
            {
                "id": "action",
                "label": "ACTION",
                "column": "action",
                "width": "15%",
                "type": "action"
            }
        ]
    },
    "form": [
        {
            "title": "Collection Information",
            "style": "main",
            "fields": [
                {
                    "label": "Title",
                    "type": "text",
                    "style": 2,
                    "name": "title",
                    "placeholder": "e.g. Summer Essentials, Limited Edition, New Tech 2026"
                },
                {
                    "label": "Description",
                    "type": "desc",
                    "style": 2,
                    "name": "description",
                    "placeholder": "Brief description of this collection..."
                }
            ]
        },
        {
            "title": "Collection Banner / Cover",
            "style": "sidebar",
            "fields": [
                {
                    "label": "Cover Image",
                    "name": "image",
                    "type": "image",
                    "style": 1,
                    "filename": ""
                }
            ]
        }
    ]
}
