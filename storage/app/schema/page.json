{
    "db": {
        "model": "App\\Models\\Posts",
        "type": "page",
        "auto_slug": "sku",
        "validation": {
            "title": "required|string|max:255",
            "description": "nullable|string|max:100000",
            "status": "required|string|max:20"
        },
        "schema": [
            {
                "name": "user_id",
                "type": "unsignedBigInteger",
                "index": true
            },
            {
                "name": "title",
                "type": "string"
            },
            {
                "name": "sku",
                "type": "string",
                "unique": true
            },
            {
                "name": "description",
                "type": "longText",
                "nullable": true
            },
            {
                "name": "status",
                "type": "string",
                "default": "publish"
            },
            {
                "name": "type",
                "type": "string",
                "index": true
            },
            {
                "name": "created_at",
                "type": "timestamp",
                "nullable": true
            },
            {
                "name": "updated_at",
                "type": "timestamp",
                "nullable": true
            }
        ],
        "main_fields": [
            "title",
            "sku",
            "description",
            "status",
            "updated_at",
            "created_at"
        ],
        "fixed_fields": {
            "user_id": "auth_id",
            "type": "page"
        },
        "relations": {
            "image": "single_image"
        },
        "meta_fields": "auto",
        "features": {
            "category": false,
            "brand": false,
            "attributes": false,
            "variations": false,
            "short_description": true
        },
        "table": "posts"
    },
    "table": {
        "card": {
            "image": "image",
            "title": "title",
            "subtitle": "sku",
            "top_right": "status",
            "actions": "action"
        },
        "keywords": true,
        "paginationPerPage": 10,
        "paginationList": [
            10,
            20,
            50,
            100
        ],
        "table": "posts",
        "type": "page",
        "bulk": {
            "table": "posts",
            "type": "page",
            "route": "bulk.action",
            "column": "status",
            "is_meta": false,
            "options": [
                {
                    "label": "Delete",
                    "value": "delete"
                },
                {
                    "label": "Publish",
                    "value": "publish"
                },
                {
                    "label": "Draft",
                    "value": "Draft"
                }
            ]
        },
        "columns": [
            {
                "id": "id",
                "label": "ID",
                "column": "id",
                "width": "5%",
                "sort": true
            },
            {
                "id": "image",
                "label": "IMAGE",
                "width": "10%",
                "column": "image",
                "type": "image",
                "key": "filename"
            },
            {
                "id": "title",
                "label": "PAGE TITLE",
                "column": "title",
                "sort": true,
                "width": "35%"
            },
            {
                "id": "sku",
                "label": "SLUG / URL",
                "column": "sku",
                "width": "20%",
                "sort": true
            },
            {
                "id": "status",
                "label": "STATUS",
                "column": "status",
                "width": "15%",
                "type": "status_dot"
            },
            {
                "id": "action",
                "label": "ACTION",
                "column": "action",
                "width": "15%",
                "type": "action"
            }
        ]
    },
    "form": [
        {
            "title": "Page Content",
            "style": "main",
            "fields": [
                {
                    "label": "Page Title",
                    "name": "title",
                    "type": "text",
                    "placeholder": "e.g. About Us, Privacy Policy, Contact Us...",
                    "attribute": "required",
                    "style": 2
                },
                {
                    "label": "Slug / URL Identifier",
                    "name": "sku",
                    "type": "text",
                    "placeholder": "e.g. about-us",
                    "attribute": "required",
                    "style": 2
                },
                {
                    "label": "Subtitle / Short Description",
                    "name": "short_description",
                    "type": "desc",
                    "placeholder": "Short summary or subtitle for header...",
                    "translate": true
                },
                {
                    "label": "Page Content (Rich Text)",
                    "name": "description",
                    "type": "desc",
                    "placeholder": "Write full page content here...",
                    "translate": true
                }
            ]
        },
        {
            "title": "Page Layout & Structure",
            "style": "main",
            "tab": "Layout",
            "fields": [
                {
                    "label": "Page Layout Type",
                    "name": "layout_type",
                    "type": "dropdown",
                    "placeholder": "Select page layout...",
                    "style": 2,
                    "options": [
                        { "id": "sidebar_right", "title": "Sidebar Right (Content 2/3 + Sidebar 1/3)" },
                        { "id": "sidebar_left", "title": "Sidebar Left (Sidebar 1/3 + Content 2/3)" },
                        { "id": "narrow_center", "title": "Narrow Centered (Focused Reading View)" },
                        { "id": "full_width", "title": "Full Width (Single Column)" }
                    ]
                },
                {
                    "label": "Container Width",
                    "name": "container_width",
                    "type": "dropdown",
                    "style": 2,
                    "options": [
                        { "id": "container", "title": "Standard (max-w-6xl)" },
                        { "id": "narrow", "title": "Narrow (max-w-4xl)" },
                        { "id": "wide", "title": "Wide (max-w-7xl)" },
                        { "id": "full", "title": "Full Width (100%)" }
                    ]
                },
                {
                    "label": "Header Style",
                    "name": "header_style",
                    "type": "dropdown",
                    "style": 2,
                    "options": [
                        { "id": "hero_gradient", "title": "Hero Gradient Banner" },
                        { "id": "clean_minimal", "title": "Clean Minimal Title Bar" },
                        { "id": "with_image", "title": "Featured Banner Image" },
                        { "id": "none", "title": "No Header (Content Only)" }
                    ]
                },
                {
                    "label": "Show Breadcrumbs",
                    "name": "show_breadcrumbs",
                    "type": "checkbox",
                    "value": true
                },
                {
                    "label": "Sticky Sidebar on Scroll",
                    "name": "sticky_sidebar",
                    "type": "checkbox",
                    "value": true
                }
            ]
        },
        {
            "title": "Sidebar & Pre-Footer Widgets",
            "style": "main",
            "tab": "Layout",
            "fields": [
                {
                    "label": "Sidebar Widgets (Choose & Enable)",
                    "name": "sidebar_widgets",
                    "type": "dropdown",
                    "multiple": true,
                    "placeholder": "Select widgets to display in sidebar...",
                    "options": [
                        { "id": "toc", "title": "Table of Contents (Auto Headings Navigation)" },
                        { "id": "recent_blogs", "title": "Recent Blog Articles" },
                        { "id": "categories", "title": "Explore Categories" },
                        { "id": "contact_card", "title": "Need Help? Contact Card" },
                        { "id": "newsletter", "title": "Newsletter Subscription Box" },
                        { "id": "related_pages", "title": "Related Company Pages" },
                        { "id": "custom_cta", "title": "Custom Call-to-Action Card" }
                    ]
                },
                {
                    "label": "Bottom / Pre-Footer Section (Above Footer)",
                    "name": "footer_widget",
                    "type": "dropdown",
                    "options": [
                        { "id": "none", "title": "None (No Pre-Footer Widget)" },
                        { "id": "cta_banner", "title": "Call-To-Action Banner" },
                        { "id": "faq_accordion", "title": "FAQ Accordion (Top Questions)" },
                        { "id": "contact_grid", "title": "3-Column Contact & Support Grid" },
                        { "id": "recent_blogs", "title": "Latest Blog Articles Grid" },
                        { "id": "newsletter", "title": "Newsletter Banner Section" }
                    ]
                },
                {
                    "label": "Bottom CTA Heading",
                    "name": "footer_cta_title",
                    "type": "text",
                    "placeholder": "e.g. Have questions or need assistance?",
                    "style": 2
                },
                {
                    "label": "Bottom CTA Button Text",
                    "name": "footer_cta_btn_text",
                    "type": "text",
                    "placeholder": "e.g. Contact Support",
                    "style": 2
                },
                {
                    "label": "Bottom CTA Button Link",
                    "name": "footer_cta_btn_url",
                    "type": "text",
                    "placeholder": "e.g. /page/contact-us",
                    "style": 2
                },
                {
                    "label": "Bottom CTA Description",
                    "name": "footer_cta_desc",
                    "type": "textarea",
                    "placeholder": "Our customer support team is available 24/7 to assist you."
                }
            ]
        },
        {
            "title": "Custom Widget Cards (Optional)",
            "style": "main",
            "tab": "Layout",
            "fields": [
                {
                    "label": "Custom Widget Cards",
                    "name": "custom_widgets",
                    "type": "repeater",
                    "fields": [
                        { "name": "title", "label": "Widget Title", "type": "text", "placeholder": "e.g. Special Offer or Notice" },
                        { "name": "content", "label": "Widget Content", "type": "textarea", "placeholder": "Enter widget details or description..." },
                        { "name": "button_text", "label": "Button Label", "type": "text", "placeholder": "e.g. Learn More" },
                        { "name": "button_url", "label": "Button URL", "type": "text", "placeholder": "e.g. /blog" }
                    ]
                }
            ]
        },
        {
            "title": "Page Banner Image",
            "style": "main",
            "tab": "Media",
            "fields": [
                {
                    "label": "Header Banner Image",
                    "name": "image",
                    "type": "image"
                }
            ]
        },
        {
            "title": "Search Engine Optimization (SEO)",
            "style": "main",
            "tab": "SEO",
            "fields": [
                {
                    "label": "SEO Meta Title",
                    "name": "seo_title",
                    "type": "text",
                    "placeholder": "Meta title for search engines",
                    "style": 2
                },
                {
                    "label": "SEO Keywords",
                    "name": "seo_keywords",
                    "type": "text",
                    "placeholder": "about, company, policy",
                    "style": 2
                },
                {
                    "label": "SEO Meta Description",
                    "name": "seo_description",
                    "type": "desc",
                    "placeholder": "Meta description for search engine result snippets..."
                }
            ]
        },
        {
            "title": "Publish Settings",
            "style": "sidebar",
            "fields": [
                {
                    "label": "Status",
                    "name": "status",
                    "type": "dropdown",
                    "options": [
                        {
                            "title": "Publish",
                            "id": "publish"
                        },
                        {
                            "title": "Draft",
                            "id": "draft"
                        }
                    ]
                }
            ]
        }
    ]
}
