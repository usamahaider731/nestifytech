{
    "db": {
        "model": "App\\Models\\User",
        "type": "user",
        "validation": {
            "name": "required|string|max:255",
            "email": "required|email|unique:users"
        },
        "schema": [
            {
                "name": "name",
                "type": "string"
            },
            {
                "name": "email",
                "type": "string",
                "unique": true
            },
            {
                "name": "password",
                "type": "string"
            },
            {
                "name": "active",
                "type": "boolean",
                "default": true
            },
            {
                "name": "created_at",
                "type": "timestamp",
                "nullable": true
            },
            {
                "name": "updated_at",
                "type": "timestamp",
                "nullable": true
            }
        ],
        "main_fields": [
            "name",
            "email",
            "roles",
            "password",
            "active"
        ],
        "meta_fields": "auto",
        "fixed_fields": {},
        "table": "users"
    },
    "table": {
        "card": {
            "image": "image",
            "title": "name",
            "subtitle": "email",
            "top_right": "active",
            "badges": [
                "role"
            ],
            "actions": "action"
        },
        "keywords": true,
        "paginationPerPage": 10,
        "paginationList": [
            10,
            20,
            50,
            100
        ],
        "table": "users",
        "type": "user",
        "bulk": {
            "table": "users",
            "type": "user",
            "route": "bulk.action",
            "column": "active",
            "is_meta": false,
            "options": [
                {
                    "label": "Delete",
                    "value": "delete"
                },
                {
                    "label": "Active",
                    "value": "1"
                },
                {
                    "label": "Inactive",
                    "value": "0"
                }
            ]
        },
        "columns": [
            {
                "id": "id",
                "label": "ID",
                "column": "id",
                "width": "5%",
                "sort": true
            },
            {
                "id": "image",
                "label": "IMAGE",
                "width": "5%",
                "column": "image",
                "type": "image",
                "key": "filename"
            },
            {
                "id": "name",
                "label": "USER",
                "column": "name",
                "sort": true,
                "width": "20%"
            },
            {
                "id": "role",
                "label": "ROLE",
                "column": "user_role",
                "type": "role_badges",
                "source_column": "roles",
                "value_table": "roles",
                "is_array": true,
                "meta_value_type": "json",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                },
                "width": "30%"
            },
            {
                "id": "active",
                "label": "ACTIVE",
                "column": "active",
                "type": "status_dot",
                "width": "20%"
            },
            {
                "id": "action",
                "label": "ACTION",
                "column": "action",
                "width": "20%",
                "type": "action"
            }
        ]
    },
    "form": [
        {
            "title": "User Information",
            "style": "main",
            "fields": [
                {
                    "label": "Name",
                    "style": 1,
                    "name": "name",
                    "type": "text",
                    "placeholder": "User Name"
                },
                {
                    "label": "Email",
                    "style": 1,
                    "name": "email",
                    "type": "text",
                    "placeholder": "User Email"
                },
                {
                    "name": "date_of_birth",
                    "label": "Date of Birth",
                    "type": "date",
                    "style": 1,
                    "placeholder": "YYYY-MM-DD"
                },
                {
                    "name": "cnic",
                    "label": "CNIC Number",
                    "type": "text",
                    "style": 1,
                    "placeholder": "e.g. 35202-1234567-1"
                },
                {
                    "name": "phone",
                    "label": "Phone Number",
                    "type": "phone",
                    "style": 2,
                    "placeholder": "Enter Phone Number"
                },
                {
                    "name": "bio",
                    "label": "Bio / About",
                    "style": 2,
                    "type": "textarea",
                    "placeholder": "Bio"
                }
            ]
        },
        {
            "title": "User Address",
            "style": "main",
            "fields": [
                {
                    "name": "address",
                    "label": "Street Address",
                    "type": "dropdown",
                    "searchable": true,
                    "options": {
                        "api": "https://photon.komoot.io",
                        "endpoint": "/api/?q={query}&limit=5",
                        "proxy": "/api/geocode",
                        "location_field": "address_coordinates"
                    },
                    "style": 2
                },
                {
                    "label": "State",
                    "name": "state",
                    "type": "dropdown",
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "state"
                    }
                },
                {
                    "label": "City",
                    "name": "city",
                    "type": "dropdown",
                    "searchable": true,
                    "depends_on": "state",
                    "options": {
                        "model": "Taxonomy",
                        "type": "city"
                    }
                }
            ]
        },
        {
            "title": "User Role",
            "style": "main",
            "fields": [
                {
                    "type": "checkbox",
                    "name": "roles",
                    "options": {
                        "model": "Roles",
                        "type": "role",
                        "use_value": false
                    }
                }
            ]
        },
        {
            "title": "User Image",
            "style": "sidebar",
            "fields": [
                {
                    "label": "",
                    "style": 1,
                    "name": "image",
                    "type": "image",
                    "auto_avatar": true,
                    "value": ""
                }
            ]
        }
    ],
    "show": [
        {
            "title": "Profile Information",
            "style": "main",
            "fields": [
                { "name": "name", "label": "Full Name", "type": "text" },
                { "name": "email", "label": "Email Address", "type": "text" },
                { "name": "phone", "label": "Phone Number", "type": "text" },
                { "name": "cnic", "label": "CNIC", "type": "text" },
                { "name": "date_of_birth", "label": "Date of Birth", "type": "text" },
                { "name": "active", "label": "Account Status", "type": "status" },
                { "name": "bio", "label": "Bio / About", "type": "desc" }
            ]
        },
        {
            "title": "Location & Roles",
            "style": "sidebar",
            "fields": [
                {
                    "name": "roles",
                    "label": "Assigned Roles",
                    "type": "dropdown",
                    "multiple": true,
                    "options": { "model": "Roles", "type": "role" }
                },
                {
                    "name": "state",
                    "label": "State / Province",
                    "type": "dropdown",
                    "options": { "model": "Taxonomy", "type": "state" }
                },
                {
                    "name": "city",
                    "label": "City",
                    "type": "dropdown",
                    "options": { "model": "Taxonomy", "type": "city" }
                },
                { "name": "address", "label": "Street Address", "type": "text" },
                { "name": "image", "label": "Avatar / Image", "type": "image" }
            ]
        }
    ]
}