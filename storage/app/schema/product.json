{
    "db": {
        "model": "App\\Models\\Posts",
        "type": "product",
        "validation": {
            "title": "required|string|max:100",
            "description": "nullable|string|max:10000",
            "status": "required|string|max:20",
            "sku": "required|string|max:50"
        },
        "schema": [
            {
                "name": "user_id",
                "type": "unsignedBigInteger",
                "index": true
            },
            {
                "name": "title",
                "type": "string"
            },
            {
                "name": "sku",
                "type": "string",
                "unique": true
            },
            {
                "name": "description",
                "type": "longText",
                "nullable": true
            },
            {
                "name": "status",
                "type": "string",
                "default": "publish"
            },
            {
                "name": "type",
                "type": "string",
                "index": true
            },
            {
                "name": "created_at",
                "type": "timestamp",
                "nullable": true
            },
            {
                "name": "updated_at",
                "type": "timestamp",
                "nullable": true
            }
        ],
        "main_fields": [
            "title",
            "description",
            "status",
            "sku",
            "updated_at",
            "created_at"
        ],
        "fixed_fields": {
            "user_id": "auth_id",
            "type": "product"
        },
        "relations": {
            "image": "single_image",
            "gallery": "gallery_image",
            "attributes": "attributes",
            "variations": "variations"
        },
        "meta_fields": "auto",
        "features": {
            "category": true,
            "brand": true,
            "attributes": true,
            "variations": true,
            "short_description": true,
            "category_filter": true
        },
        "meta_processing": {
            "category": "json_array",
            "brand": "string",
            "store": "string"
        },
        "table": "posts"
    },
    "table": {
        "card": {
            "image": "image",
            "title": "title",
            "subtitle": "sku",
            "top_right": "status",
            "badges": ["category", "brand"],
            "actions": "action"
        },
        "keywords": true,
        "paginationPerPage": 10,
        "paginationList": [
            10,
            20,
            50,
            100
        ],
        "table": "posts",
        "type": "product",
        "bulk": {
            "table": "posts",
            "type": "product",
            "route": "bulk.action",
            "column": "status",
            "is_meta": false,
            "options": [
                {
                    "label": "Delete",
                    "value": "delete"
                },
                {
                    "label": "Publish",
                    "value": "publish"
                },
                {
                    "label": "Draft",
                    "value": "Draft"
                }
            ]
        },
        "columns": [
            {
                "id": "id",
                "label": "ID",
                "column": "id",
                "width": "5%",
                "sort": true
            },
            {
                "id": "sku",
                "label": "SKU",
                "column": "sku",
                "width": "10%",
                "sort": true
            },
            {
                "id": "image",
                "label": "IMAGE",
                "width": "5%",
                "column": "image",
                "type": "image",
                "key": "filename"
            },
            {
                "id": "title",
                "label": "PRODUCT",
                "column": "title",
                "sort": true,
                "width": "20%"
            },
            {
                "id": "category",
                "column": "parent",
                "label": "CATEGORY",
                "type": "badage",
                "field": "category",
                "meta": true,
                "meta_key": "category",
                "value_table": "taxonomies",
                "is_array": true,
                "meta_value_type": "json",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                },
                "width": "20%"
            },
            {
                "id": "brand",
                "label": "BRAND",
                "type": "brand_image",
                "field": "brand",
                "meta": true,
                "meta_key": "brand",
                "value_table": "taxonomies",
                "meta_value_type": "string",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                },
                "media_type": "taxonomy",
                "width": "10%"
            },
            {
                "id": "collection",
                "column": "collection",
                "label": "COLLECTION",
                "type": "badage",
                "field": "collection",
                "meta": true,
                "meta_key": "collection",
                "value_table": "taxonomies",
                "is_array": true,
                "meta_value_type": "json",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                }
            },
            {
                "id": "tags",
                "column": "tags",
                "label": "TAGS",
                "type": "badage",
                "field": "tags",
                "meta": true,
                "meta_key": "tags",
                "value_table": "taxonomies",
                "is_array": true,
                "meta_value_type": "json",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                }
            },
            {
                "id": "supplier",
                "column": "supplier",
                "label": "SUPPLIER",
                "type": "badage",
                "field": "supplier",
                "meta": true,
                "meta_key": "supplier",
                "value_table": "taxonomies",
                "value_condition": {
                    "pass_value_of_key": "id",
                    "return_key": "title"
                }
            },
            {
                "id": "status",
                "label": "STATUS",
                "column": "status",
                "width": "10%",
                "type": "status_dot"
            },
            {
                "id": "action",
                "label": "ACTION",
                "column": "action",
                "width": "20%",
                "type": "action"
            }
        ]
    },
    "form": [
        {
            "title": "Basic Information",
            "style": "main",
            "fields": [
                {
                    "label": "Product Title",
                    "name": "title",
                    "type": "text",
                    "placeholder": "e.g. Wireless Headphone Pro",
                    "attribute": "required",
                    "style": 2
                },
                {
                    "label": "SKU / Model",
                    "name": "sku",
                    "type": "text",
                    "placeholder": "WP-001",
                    "attribute": "required",
                    "style": 2
                },
                {
                    "label": "Short Description",
                    "name": "short_description",
                    "type": "desc",
                    "placeholder": "Write product short details here...",
                    "translate": true,
                    "generate_required": [
                        "title",
                        "category",
                        "brand"
                    ]
                },
                {
                    "label": "Full Description",
                    "name": "description",
                    "type": "desc",
                    "placeholder": "Write product details here...",
                    "translate": true,
                    "generate_required": [
                        "title",
                        "category",
                        "brand"
                    ]
                }
            ]
        },
        {
            "title": "Media Assets",
            "style": "main",
            "tab": "Gallery",
            "fields": [
                {
                    "label": "Featured Image",
                    "name": "image",
                    "type": "image"
                },
                {
                    "label": "Product Gallery",
                    "name": "gallery",
                    "type": "image",
                    "multiple": true
                }
            ]
        },
        {
            "title": "Search Engine Optimization (SEO)",
            "style": "main",
            "tab": "SEO",
            "fields": [
                {
                    "label": "SEO Title",
                    "name": "seo_title",
                    "type": "text",
                    "placeholder": "Custom title for search engines",
                    "style": 2
                },
                {
                    "label": "SEO Keywords",
                    "name": "seo_keywords",
                    "type": "text",
                    "placeholder": "keywords, separated, by, commas",
                    "style": 2
                },
                {
                    "label": "SEO Meta Description",
                    "name": "seo_description",
                    "type": "desc",
                    "placeholder": "Summary of the product for snippets..."
                }
            ]
        },
        {
            "title": "Technical Attributes",
            "style": "main",
            "tab": "Attributes",
            "fields": [
                {
                    "label": "Technical Attributes",
                    "name": "attributes",
                    "type": "attributes"
                }
            ]
        },
        {
            "title": "Product Variations",
            "style": "main",
            "tab": "Variations",
            "fields": [
                {
                    "label": "Product Variations",
                    "name": "variations",
                    "type": "variations"
                }
            ]
        },
        {
            "title": "Organize",
            "style": "sidebar",
            "fields": [
                {
                    "label": "Category",
                    "name": "category",
                    "type": "dropdown",
                    "multiple": true,
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "category"
                    }
                },
                {
                    "label": "Product Brand",
                    "name": "brand",
                    "type": "dropdown",
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "brand"
                    }
                },
                {
                    "label": "Tags",
                    "name": "tags",
                    "type": "dropdown",
                    "multiple": true,
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "tag"
                    }
                },
                {
                    "label": "Collection",
                    "name": "collection",
                    "type": "dropdown",
                    "multiple": true,
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "collection"
                    }
                },
                {
                    "label": "Supplier / Vendor",
                    "name": "supplier",
                    "type": "dropdown",
                    "searchable": true,
                    "options": {
                        "model": "Taxonomy",
                        "type": "supplier"
                    }
                }
            ]
        },
        {
            "title": "Store & Fulfillment",
            "style": "main",
            "tab": "Store",
            "fields": [
                {
                    "label": "Store / Branch",
                    "name": "store",
                    "type": "dropdown",
                    "searchable": true,
                    "placeholder": "Select Store / Branch",
                    "options": {
                        "model": "Store",
                        "type": "store"
                    },
                    "style": 2
                }
            ]
        },
        {
            "title": "Services & Policies",
            "style": "main",
            "tab": "Services",
            "fields": [
                {
                    "label": "Warranty Period",
                    "name": "warranty",
                    "type": "text",
                    "placeholder": "e.g. 1 Year Official Brand Warranty",
                    "style": 2
                },
                {
                    "label": "Exchange / Return Policy",
                    "name": "exchange",
                    "type": "text",
                    "placeholder": "e.g. 7 Days Hassle-Free Replacement / Exchange",
                    "style": 2
                },
                {
                    "label": "Installment Plan",
                    "name": "installment",
                    "type": "text",
                    "placeholder": "e.g. Available up to 12 months with 0% markup",
                    "style": 2
                }
            ]
        },
        {
            "title": "Price Adjustment",
            "style": "sidebar",
            "fields": [
                {
                    "label": "Cost / Buy Price (Internal)",
                    "type": "text",
                    "name": "buy_price",
                    "placeholder": "Purchase cost from supplier"
                },
                {
                    "label": "Regular Price",
                    "type": "text",
                    "name": "first_price"
                },
                {
                    "label": "Sale Price",
                    "type": "text",
                    "name": "second_price"
                },
                {
                    "label": "Stock Quantity",
                    "type": "number",
                    "name": "stock"
                }
            ]
        }
    ],
    "show": [
        {
            "title": "Basic Information",
            "style": "main",
            "fields": [
                { "name": "title", "label": "Product Title", "type": "text" },
                { "name": "sku", "label": "SKU / Model", "type": "text" },
                { "name": "status", "label": "Status", "type": "status" },
                { "name": "short_description", "label": "Short Description", "type": "desc" },
                { "name": "description", "label": "Full Description", "type": "desc" }
            ]
        },
        {
            "title": "Pricing & Stock",
            "style": "main",
            "fields": [
                { "name": "first_price", "label": "Regular Price", "type": "text" },
                { "name": "second_price", "label": "Sale Price", "type": "text" },
                { "name": "buy_price", "label": "Cost / Buy Price", "type": "text" },
                { "name": "stock", "label": "Stock Quantity", "type": "number" }
            ]
        },
        {
            "title": "Taxonomies & Classification",
            "style": "sidebar",
            "fields": [
                {
                    "name": "category",
                    "label": "Categories",
                    "type": "dropdown",
                    "multiple": true,
                    "options": { "model": "Taxonomy", "type": "category" }
                },
                {
                    "name": "brand",
                    "label": "Brand",
                    "type": "dropdown",
                    "options": { "model": "Taxonomy", "type": "brand" }
                },
                {
                    "name": "collection",
                    "label": "Collections",
                    "type": "dropdown",
                    "multiple": true,
                    "options": { "model": "Taxonomy", "type": "collection" }
                },
                {
                    "name": "tags",
                    "label": "Tags",
                    "type": "dropdown",
                    "multiple": true,
                    "options": { "model": "Taxonomy", "type": "tag" }
                },
                {
                    "name": "supplier",
                    "label": "Supplier / Vendor",
                    "type": "dropdown",
                    "options": { "model": "Taxonomy", "type": "supplier" }
                },
                {
                    "name": "store",
                    "label": "Store / Branch",
                    "type": "dropdown",
                    "options": { "model": "Store", "type": "store" }
                }
            ]
        },
        {
            "title": "Media & Gallery",
            "style": "main",
            "fields": [
                { "name": "image", "label": "Featured Image", "type": "image" },
                { "name": "gallery", "label": "Gallery Images", "type": "gallery" }
            ]
        },
        {
            "title": "Technical Attributes",
            "style": "main",
            "fields": [
                { "name": "attributes", "label": "Technical Attributes", "type": "attributes" }
            ]
        },
        {
            "title": "Product Variations",
            "style": "main",
            "fields": [
                { "name": "variations", "label": "Variations", "type": "variations" }
            ]
        },
        {
            "title": "Policies & Services",
            "style": "sidebar",
            "fields": [
                { "name": "warranty", "label": "Warranty Period", "type": "text" },
                { "name": "exchange", "label": "Exchange / Return Policy", "type": "text" },
                { "name": "installment", "label": "Installment Plan", "type": "text" }
            ]
        },
        {
            "title": "SEO Information",
            "style": "main",
            "fields": [
                { "name": "seo_title", "label": "SEO Title", "type": "text" },
                { "name": "seo_keywords", "label": "SEO Keywords", "type": "text" },
                { "name": "seo_description", "label": "SEO Description", "type": "desc" }
            ]
        }
    ]
}