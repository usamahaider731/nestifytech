{
    "db": {
        "model": "App\\Models\\Roles",
        "type": "role",
        "validation": {
            "title": "required|string|unique:roles"
        },
        "schema": [
            {
                "name": "title",
                "type": "string"
            },
            {
                "name": "scope",
                "type": "string",
                "default": "platform"
            },
            {
                "name": "status",
                "type": "string",
                "default": "active"
            },
            {
                "name": "permission",
                "type": "longText",
                "nullable": true
            },
            {
                "name": "created_at",
                "type": "timestamp",
                "nullable": true
            },
            {
                "name": "updated_at",
                "type": "timestamp",
                "nullable": true
            }
        ],
        "main_fields": [
            "title",
            "scope",
            "status",
            "permission"
        ],
        "meta_fields": "auto",
        "table": "roles"
    },
    "table": {
        "card": {
            "title": "title",
            "top_right": "status",
            "badges": ["users"],
            "actions": "action"
        },
        "keywords": true,
        "paginationPerPage": 10,
        "paginationList": [
            10,
            20,
            50,
            100
        ],
        "table": "roles",
        "type": "role",
        "columns": [
            {
                "id": "id",
                "label": "ID",
                "column": "id",
                "width": "70px",
                "sort": true
            },
            {
                "id": "title",
                "label": "ROLE",
                "column": "title",
                "sort": true,
                "width": "240px"
            },
            {
                "id": "scope",
                "label": "SCOPE",
                "column": "scope",
                "sort": true,
                "width": "160px",
                "type": "text"
            },
            {
                "id": "status",
                "label": "STATUS",
                "column": "status",
                "width": "120px",
                "type": "status_dot"
            },
            {
                "id": "action",
                "label": "ACTION",
                "column": "action",
                "width": "120px",
                "type": "action"
            }
        ]
    },
    "form": [
        {
            "title": "Role Details",
            "style": "main",
            "fields": [
                {
                    "label": "Role Title",
                    "name": "title",
                    "type": "text",
                    "placeholder": "e.g. Administrator, Store Manager...",
                    "style": 2
                },
                {
                    "label": "Role Scope",
                    "name": "scope",
                    "type": "dropdown",
                    "options": [
                        {
                            "title": "Main Platform (Global)",
                            "id": "platform"
                        },
                        {
                            "title": "Store / Branch Specific",
                            "id": "store"
                        }
                    ],
                    "desc": "Select whether this role applies to the main global platform or specific store branches.",
                    "style": 2
                },
                {
                    "label": "Status",
                    "name": "status",
                    "type": "dropdown",
                    "options": [
                        {
                            "title": "Active",
                            "id": "active"
                        },
                        {
                            "title": "Inactive",
                            "id": "inactive"
                        }
                    ],
                    "style": 2
                }
            ]
        },
        {
            "title": "Dashboard",
            "style": "main",
            "fields": [
                {
                    "label": "Dashboard Access",
                    "name": "permission.dashboard",
                    "type": "matrix",
                    "rows": [
                        "Dashboard"
                    ],
                    "cols": [
                        "Read"
                    ]
                }
            ]
        },
        {
            "title": "Content Management permission",
            "style": "main",
            "fields": [
                {
                    "label": "Content Access",
                    "name": "permission.content",
                    "type": "matrix",
                    "rows": [
                        "Product",
                        "Store",
                        "Blog",
                        "Blog Category",
                        "Faq",
                        "Faq Category",
                        "Page",
                        "Category",
                        "Brand",
                        "Tag",
                        "Attributes"
                    ],
                    "cols": [
                        "Read",
                        "Write",
                        "Delete"
                    ]
                }
            ]
        },
        {
            "title": "System Control permission",
            "style": "main",
            "fields": [
                {
                    "label": "Administrative Access",
                    "name": "permission.system",
                    "type": "matrix",
                    "rows": [
                        "User",
                        "Role",
                        "Setting",
                        "Transition",
                        "Layout",
                        "Developer",
                        "Ads"
                    ],
                    "cols": [
                        "Read",
                        "Write",
                        "Delete"
                    ]
                }
            ]
        },
        {
            "title": "User Interaction permission",
            "style": "main",
            "fields": [
                {
                    "label": "Customer Engagement",
                    "name": "permission.sales",
                    "type": "matrix",
                    "rows": [
                        "Reviews",
                        "Order"
                    ],
                    "cols": [
                        "Read",
                        "Write",
                        "Delete"
                    ]
                }
            ]
        },
        {
            "title": "Delivery permission",
            "style": "main",
            "fields": [
                {
                    "label": "Delivery Boy Access",
                    "name": "permission.delivery",
                    "type": "matrix",
                    "rows": [
                        "Delivery"
                    ],
                    "cols": [
                        "Read",
                        "Write"
                    ]
                }
            ]
        }
    ]
}